set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
get_filename_component(MH4U_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
set(MH4U_LLVM "${MH4U_ROOT}/.tools/llvm-mingw-20261006-ucrt-macos-universal")
set(CMAKE_C_COMPILER "${MH4U_LLVM}/bin/x86_64-w64-mingw32-clang")
set(CMAKE_CXX_COMPILER "${MH4U_LLVM}/bin/x86_64-w64-mingw32-clang++")
set(CMAKE_RC_COMPILER "${MH4U_LLVM}/bin/x86_64-w64-mingw32-windres")
set(CMAKE_FIND_ROOT_PATH "${MH4U_LLVM}/x86_64-w64-mingw32")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_EXE_LINKER_FLAGS_INIT "-static")
